<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/bar_white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- Live preview of the overlay bar -->
        <include layout="@layout/overlay_status_bar" />

        <!-- Enable toggle card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface_card"
            android:padding="16dp"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/enable_overlay"
                android:textColor="@color/bar_white"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/switchEnable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Permission buttons -->
        <Button
            android:id="@+id/btnOverlayPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/grant_overlay_permission" />

        <Button
            android:id="@+id/btnAccessibilityPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/grant_accessibility_permission" />

        <!-- Transparent background -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface_card"
            android:padding="16dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Transparent Background"
                android:textColor="@color/bar_white"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/switchTransparent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Auto-hide in fullscreen apps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface_card"
            android:padding="16dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Auto-hide in Fullscreen Apps"
                android:textColor="@color/bar_white"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/switchAutoHide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Clock format -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clock_format"
            android:textColor="@color/bar_gray"
            android:textSize="13sp"
            android:layout_marginTop="24dp" />

        <Spinner
            android:id="@+id/spinnerClockFormat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <!-- Icon color -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/icon_color"
            android:textColor="@color/bar_gray"
            android:textSize="13sp"
            android:layout_marginTop="20dp" />

        <LinearLayout
            android:id="@+id/colorSwatchRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp" />

        <!-- Battery style -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/battery_style"
            android:textColor="@color/bar_gray"
            android:textSize="13sp"
            android:layout_marginTop="20dp" />

        <Spinner
            android:id="@+id/spinnerBatteryStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <!-- Carrier name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Carrier Name"
            android:textColor="@color/bar_gray"
            android:textSize="13sp"
            android:layout_marginTop="20dp" />

        <EditText
            android:id="@+id/etCarrierName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="MTN NG"
            android:textColorHint="@color/bar_gray"
            android:textColor="@color/bar_white"
            android:inputType="text"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface_card"
            android:padding="16dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Show Carrier Name"
                android:textColor="@color/bar_white"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/switchShowCarrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Network type -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Network Type"
            android:textColor="@color/bar_gray"
            android:textSize="13sp"
            android:layout_marginTop="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface_card"
            android:padding="16dp"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Auto-detect (fallback to manual below)"
                android:textColor="@color/bar_white"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switchNetworkAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <Spinner
            android:id="@+id/spinnerManualNetwork"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <!-- Live system-state icons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface_card"
            android:padding="16dp"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Show Live System Icons (data, BT, hotspot, DND, etc.)"
                android:textColor="@color/bar_white"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switchSystemIcons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Notification icon picker -->
        <Button
            android:id="@+id/btnPickNotificationIcons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Choose Notification Icons (max 5)" />

        <!-- Battery / autostart -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keep the Service Alive on Infinix/XOS"
            android:textColor="@color/bar_gray"
            android:textSize="13sp"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btnIgnoreBatteryOptimization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ignore Battery Optimization" />

        <Button
            android:id="@+id/btnAutostartSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Open Autostart / Lock App Settings" />

    </LinearLayout>
</ScrollView>
