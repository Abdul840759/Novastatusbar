<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="32dp"
    android:background="@color/bar_black">

    <!-- LEFT ZONE: nothing else may ever be placed here.
         Unlocked: clock + fake notification icons.
         Locked: carrier name only (the two groups are toggled, never both visible). -->
    <LinearLayout
        android:id="@+id/leftZone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_marginStart="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvCarrierName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MTN NG"
            android:textColor="@color/bar_white"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/unlockedLeftGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9:41"
                android:textColor="@color/bar_white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/notificationIconRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical" />

        </LinearLayout>
    </LinearLayout>

    <!-- RIGHT ZONE: nothing else may ever be placed here. Overflow icons
         beyond the cap are silently dropped by StatusIconManager rather
         than wrapping or pushing into the center. -->
    <LinearLayout
        android:id="@+id/rightZone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/systemIconRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/tvNetworkType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="4G"
            android:textColor="@color/bar_white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivSignal"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_status_signal"
            android:contentDescription="@null" />

        <LinearLayout
            android:id="@+id/batteryPillContainer"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_solid"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp">

            <com.abdulazeez.statusclone.BatteryIconView
                android:id="@+id/batteryIconView"
                android:layout_width="22dp"
                android:layout_height="12dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvBatteryPct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="100"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
